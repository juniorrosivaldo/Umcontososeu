{
  "name": "Um Conto Só Seu MVP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "containerEnv": {
    "APP_HOST": "0.0.0.0"
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash .devcontainer/start-preview.sh",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Painel Um Conto",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8000": {
      "label": "API Um Conto",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  }
}
