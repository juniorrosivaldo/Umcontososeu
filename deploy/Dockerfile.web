# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca npm ci --strict-ssl=true --no-audit --no-fund; \
    else \
      npm ci --strict-ssl=true --no-audit --no-fund; \
    fi
COPY app app
COPY components components
COPY lib lib
COPY next.config.ts next-env.d.ts tsconfig.json ./
RUN npm run build

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca npm ci --strict-ssl=true --omit=dev --no-audit --no-fund; \
    else \
      npm ci --strict-ssl=true --omit=dev --no-audit --no-fund; \
    fi && npm cache clean --force
COPY --from=build /app/.next .next
COPY --from=build /app/next.config.ts ./
EXPOSE 3000
CMD ["sh", "-c", "exec npm run start -- --hostname 0.0.0.0 --port ${PORT:-3000}"]
