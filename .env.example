# LOCAL: use the included SQLite database; never expose local auth to the Internet.
APP_MODE=local
DATABASE_URL=sqlite:///./data/umconto.db
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_MODE=local
APP_ORIGIN=http://127.0.0.1:3000
TZ=America/Fortaleza

# PRODUCTION: APP_MODE=production and NEXT_PUBLIC_AUTH_MODE=supabase are both required.
# Apply supabase/migrations/001_initial.sql to a dedicated project before starting.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional paid inference; disabled until explicitly enabled by the operator.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_OUTPUT_TOKENS=1800

# Public RSS works without a search API. Brave search is an optional provider.
BRAVE_SEARCH_API_KEY=
SEARCH_ENABLED=false

# Instagram with Instagram Login: business/creator account and official access token.
# Set an API version currently supported by your Meta application; no default is guessed.
META_API_VERSION=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_WORKSPACE_ID=
META_APP_ID=
META_APP_SECRET=
# Publication remains unavailable in this MVP; no Instagram password is used.

# GitHub Actions: repository variable ENABLE_AGENT_AUTOMATION=true activates the job.
# Repository secret DATABASE_URL (PostgreSQL); WORKSPACE_ID selects an existing tenant.
WORKSPACE_ID=
